
# Database Connection Settings
WATCHDOG_DB_HOST=127.0.0.1
WATCHDOG_DB_PORT=3306
WATCHDOG_DB_USER=slow_query_finder
WATCHDOG_DB_PASSWORD=your_secure_password_here
WATCHDOG_DB_SCHEMA=monitoring

# Detection & Timing Thresholds
WATCHDOG_POLL_INTERVAL_SEC=60
WATCHDOG_WARN_TIME_SEC=300
WATCHDOG_HIGH_TIME_SEC=600

# Severity Classification & Lock Watermarks
WATCHDOG_CRITICAL_BLOCK_COUNT=2
WATCHDOG_ROWS_LOCKED_WATERMARK=20000

# Filtering & Noise Reduction
WATCHDOG_IGNORE_USERS=event_scheduler,system user
WATCHDOG_IGNORE_TAGS=job:archival_v2

# Alerting
WATCHDOG_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
